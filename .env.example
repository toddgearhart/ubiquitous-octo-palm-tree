# Placeholder configuration only. Copy to .env and keep real values out of Git.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Exact VM paths must be confirmed by PM-0001.
DATABASE_URL=sqlite:////var/lib/podcast-publisher/db/podcast.sqlite3
INCOMING_MEDIA_PATH=/mnt/sermons/incoming
PODCAST_OUTPUT_PATH=/mnt/podcast
