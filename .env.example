# External tools; leave blank to use a validated PATH lookup.
FFMPEG_PATH=
FFPROBE_PATH=
TESSERACT_PATH=
WHISPER_CPP_PATH=
WHISPER_MODEL_PATH=

# Future WordPress integration. Never commit populated secrets.
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=

# Future notes provider policy: disabled, configured_only, or allow_paid.
AI_POLICY=configured_only
AI_PROVIDER=
AI_API_KEY=
